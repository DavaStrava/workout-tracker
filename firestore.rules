rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Maximum number of allowed users
    function maxUsersReached() {
      return get(/databases/$(database)/documents/_metadata/userCount).data.count >= 10;
    }

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate workout data structure
    function isValidWorkout() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'name', 'type', 'startTime', 'exercises', 'status'])
        && data.name is string
        && data.name.size() <= 200
        && data.type in ['STRENGTH', 'CARDIO', 'HIIT']
        && data.status in ['active', 'completed']
        && data.exercises is list;
    }

    // Validate routine data structure
    function isValidRoutine() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'name', 'exercises'])
        && data.name is string
        && data.name.size() <= 100
        && data.exercises is list;
    }

    // Metadata document for tracking user count (admin only for writes)
    match /_metadata/userCount {
      allow read: if isAuthenticated();
      // Only Cloud Functions should update this
      allow write: if false;
    }

    // User documents - enforce user limit on creation
    match /users/{userId} {
      // Users can read their own document
      allow read: if isOwner(userId);

      // Users can create their own document if limit not reached
      // Note: For full enforcement, use Cloud Functions to atomically check and increment count
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320;

      // Users can update their own document (but not change email or createdAt)
      allow update: if isOwner(userId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;

      // Users cannot delete their own user document (admin action)
      allow delete: if false;

      // Workouts subcollection
      match /workouts/{workoutId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWorkout();
        allow update: if isOwner(userId) && isValidWorkout();
        allow delete: if isOwner(userId);
      }

      // Routines subcollection
      match /routines/{routineId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidRoutine();
        allow update: if isOwner(userId) && isValidRoutine();
        allow delete: if isOwner(userId);
      }

      // Active workout subcollection
      match /activeWorkout/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
